meta {
  name: Branches - Admin Update
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "شعبه تست Bruno ویرایش‌شده",
  "slug": "{{branchSlug}}",
  "address": "آدرس جدید تست",
  "phone": "02187654321",
  "map_url": "https://maps.google.com",
  "image": "/branch/bruno-test-updated.webp",
  "is_active": 1,
  "sort_order": 20
}
}

tests {
test('Status is 200', function() { expect(res.status).to.equal(200); });
}
