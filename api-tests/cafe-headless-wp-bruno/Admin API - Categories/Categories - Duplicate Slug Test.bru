meta {
  name: Categories - Duplicate Slug Test
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
  body: json
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Bruno Duplicate Slug",
  "slug": "{{categorySlug}}",
  "parent_id": {{categoryParentId}},
  "sort_order": 130
}
}

tests {
test('Duplicate slug returns 400', function() { expect(res.status).to.equal(400); });
}
