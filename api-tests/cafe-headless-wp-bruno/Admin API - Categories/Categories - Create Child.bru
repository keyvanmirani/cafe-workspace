meta {
  name: Categories - Create Child
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
  body: json
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "Bruno Child",
  "slug": "bruno-child-{{$timestamp}}",
  "parent_id": {{categoryGroupId}},
  "sort_order": 110
}
}

tests {
test('Status is 201', function() { expect(res.status).to.equal(201); });
test('Created child has id and slug', function() { expect(res.body.id).to.exist; bru.setVar('childCategoryId', res.body.id); bru.setVar('categoryId', res.body.id); bru.setVar('categorySlug', res.body.slug); bru.setVar('categoryParentId', res.body.parent_id); });
}
