meta {
  name: Seed Database
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/seed
  body: none
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
}

tests {
test('Status is 200 or 201', function() { expect([200, 201]).to.include(res.status); });
}
