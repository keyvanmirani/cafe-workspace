meta {
  name: Branches - Admin Create
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches
  body: json
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
{
  "name": "شعبه تست Bruno",
  "slug": "{{newBranchSlug}}",
  "address": "آدرس تست",
  "phone": "02112345678",
  "map_url": "https://maps.google.com",
  "image": "/branch/bruno-test.webp",
  "is_active": 1,
  "sort_order": 10
}
}

tests {
test('Status is 201', function() { expect(res.status).to.equal(201); });
test('Created branch has id', function() { expect(res.body.id).to.exist; bru.setVar('branchId', res.body.id); if (res.body.slug) bru.setVar('branchSlug', res.body.slug); });
}
