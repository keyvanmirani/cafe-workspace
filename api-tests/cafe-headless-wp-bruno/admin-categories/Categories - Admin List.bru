meta {
  name: Categories - Admin List
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
  body: none
  auth: basic
}

auth:basic {
  username: {{wpUsername}}
  password: {{wpAppPassword}}
}

headers {
  Accept: application/json
}

tests {
test('Status is 200', function() { expect(res.status).to.equal(200); });
test('Response is array', function() { expect(res.body).to.be.an('array'); });
}
