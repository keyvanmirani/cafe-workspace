{
  "openapi": "3.0.3",
  "info": {
    "title": "Cafe Headless WP API",
    "version": "1.0.0",
    "description": "OpenAPI import file for Bruno. Includes public menu/branch routes and admin branch/category CRUD routes for the Cafe Headless WordPress plugin."
  },
  "servers": [
    {
      "url": "https://cafeapi.wp.local",
      "description": "Local WordPress API"
    }
  ],
  "tags": [
    {
      "name": "Public"
    },
    {
      "name": "Admin Branches"
    },
    {
      "name": "Admin Categories"
    },
    {
      "name": "Maintenance"
    }
  ],
  "components": {
    "securitySchemes": {
      "WordPressApplicationPassword": {
        "type": "http",
        "scheme": "basic",
        "description": "Use WordPress username + Application Password."
      }
    },
    "schemas": {
      "Branch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "map_url": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "image_url": {
            "type": "string"
          },
          "sort_order": {
            "type": "integer"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "AdminBranch": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Branch"
          },
          {
            "type": "object",
            "properties": {
              "is_active": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              "created_at": {
                "type": "string",
                "nullable": true
              },
              "updated_at": {
                "type": "string",
                "nullable": true
              }
            }
          }
        ]
      },
      "BranchInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bruno Branch"
          },
          "slug": {
            "type": "string",
            "example": "bruno-branch-test"
          },
          "address": {
            "type": "string",
            "example": "Bruno test address"
          },
          "phone": {
            "type": "string",
            "example": "02112345678"
          },
          "map_url": {
            "type": "string",
            "example": "https://maps.google.com"
          },
          "image": {
            "type": "string",
            "example": "/branch/bruno-test.webp"
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "example": 1
          },
          "sort_order": {
            "type": "integer",
            "example": 10
          },
          "data": {
            "type": "object",
            "example": {}
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sort_order": {
            "type": "integer"
          },
          "group": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "nullable": true
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "parent_id": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "CategoryInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Bruno Group"
          },
          "slug": {
            "type": "string",
            "example": "bruno-group-test"
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "example": null
          },
          "sort_order": {
            "type": "integer",
            "example": 100
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
