      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Health",
        "operationId": "publicHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
