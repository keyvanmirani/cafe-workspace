meta {
  name: Branch Categories - Admin Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}/categories/{{categoryId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Branch Smoke Category Updated",
    "slug": "branch-smoke-category-updated-{{$timestamp}}",
    "parent_id": null,
    "sort_order": 11
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
