meta {
  name: Branch Categories - Admin Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}/categories
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Branch Smoke Category",
    "slug": "branch-smoke-category-{{$timestamp}}",
    "parent_id": null,
    "sort_order": 10
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
