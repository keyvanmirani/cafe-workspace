meta {
  name: Branches - Single by Slug
  type: http
  seq: 3
  tags: [
    Public
  ]
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/branches/:slug
  body: none
  auth: inherit
}

params:path {
  slug: mehrvila
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/branches/:slug
    method: GET
    mode: none
    params:path: {
      slug: mehrvila
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
