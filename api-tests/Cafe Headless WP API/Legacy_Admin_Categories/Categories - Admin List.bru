meta {
  name: Categories - Admin List
  type: http
  seq: 1
  tags: [
    Legacy_Admin_Categories
  ]
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

example {
  name: 200 Response
  description: OK

  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        [
          {
            "id": 0,
            "name": "",
            "slug": "",
            "sort_order": 0,
            "group": {
              "id": 0,
              "slug": "",
              "name": ""
            },
            "parent_id": 0,
            "created_at": "",
            "updated_at": ""
          }
        ]
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized

  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 401
      text: Unauthorized
    }

    body: {
      type: json
      content: '''
        {
          "code": "",
          "message": "",
          "data": {}
        }
      '''
    }
  }
}
