meta {
  name: Categories - Delete Empty
  type: http
  seq: 5
  tags: [
    Legacy_Admin_Categories
  ]
}

delete {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
  body: none
  auth: basic
}

params:path {
  id: 1
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

example {
  name: 200 Response
  description: Deleted

  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
    method: DELETE
    mode: none
    params:path: {
      id: 1
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "status": "",
          "deleted": false,
          "id": 0
        }
      '''
    }
  }
}

