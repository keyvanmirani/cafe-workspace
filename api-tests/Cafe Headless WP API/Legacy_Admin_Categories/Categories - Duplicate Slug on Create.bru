meta {
  name: Categories - Duplicate Slug on Create
  type: http
  seq: 6
  tags: [
    Legacy_Admin_Categories
  ]
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Bruno Group",
    "slug": "bruno-group-test",
    "parent_id": null,
    "sort_order": 100
  }
}

example {
  name: 201 Response (Create Group)
  description: Created

  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories
    method: POST
    mode: json
    body:json: {
      {
        "name": "Bruno Group",
        "slug": "bruno-group-test",
        "parent_id": null,
        "sort_order": 100
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 201
      text: Created
    }

    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "slug": "",
          "sort_order": 0,
          "group": {
            "id": 0,
            "slug": "",
            "name": ""
          },
          "parent_id": 0,
          "created_at": "",
          "updated_at": ""
        }
      '''
    }
  }
}

