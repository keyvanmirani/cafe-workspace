meta {
  name: Branch Variants - Admin Update
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}/items/{{itemId}}/variants/{{variantId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Branch Smoke Variant Updated",
    "description": "",
    "image": "",
    "price_raw": "110000",
    "is_active": true,
    "sort_order": 11,
    "data": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
