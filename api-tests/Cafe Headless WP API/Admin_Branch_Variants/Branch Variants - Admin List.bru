meta {
  name: Branch Variants - Admin List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}/items/{{itemId}}/variants
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

settings {
  encodeUrl: true
  timeout: 0
}
