meta {
  name: Items - Admin Update
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/items/{{itemId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {

    "category_id": 1,

    "name": "Test Update Item",

    "description": "updated description",

    "image": "test-image",

    "price": "180",

    "sale_price": "150",

    "is_variable": false,

    "is_active": true,

    "sort_order": 99

  }
}

settings {
  encodeUrl: true
  timeout: 0
}
