meta {
  name: Seed Database
  type: http
  seq: 1
  tags: [
    Maintenance
  ]
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/seed
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/seed
    method: POST
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

