meta {
  name: Items - Admin Create Variable
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/items/{{itemId}}/variants
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "category_id": 1,
    "name": "Test Latte",
    "description": "Variable item",
    "image": "",
    "price": "120",
    "sale_price": "",
    "is_variable": true,
    "is_active": true,
    "sort_order": 20
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
