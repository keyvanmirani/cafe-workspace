    "description": "Test item",
  
    "image": "",
  
    "price": "120",
  
    "sale_price": "",
  
    "is_variable": false,
  
    "is_active": true,
  
    "sort_order": 10
  
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
