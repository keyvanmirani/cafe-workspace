meta {
  name: Categories - Admin Single by ID
  type: http
  seq: 3
  tags: [
    Admin_Categories
  ]
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
  body: none
  auth: basic
}

params:path {
  id: 1
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
    method: GET
    mode: none
    params:path: {
      id: 1
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "slug": "",
          "sort_order": 0,
          "group": {
            "id": 0,
            "slug": "",
            "name": ""
          },
          "parent_id": 0,
          "created_at": "",
          "updated_at": ""
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Unauthorized
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
    method: GET
    mode: none
    params:path: {
      id: 1
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "code": "",
          "message": "",
          "data": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Not found
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
    method: GET
    mode: none
    params:path: {
      id: 1
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "code": "",
