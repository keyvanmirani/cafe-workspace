meta {
  name: Categories - Parent Self on Update
  type: http
  seq: 7
  tags: [
    Admin_Categories
  ]
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
  body: json
  auth: basic
}

params:path {
  id: 1
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Bruno Child Updated",
    "slug": "bruno-child-test",
    "parent_id": {{categoryId}},
    "sort_order": 120
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/categories/:id
    method: PUT
    mode: json
    params:path: {
      id: 1
    }
  
    body:json: {
      {
        "name": "Bruno Child Updated",
        "slug": "bruno-child-test",
        "parent_id": 1,
        "sort_order": 120
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": 0,
          "name": "",
          "slug": "",
          "sort_order": 0,
          "group": {
            "id": 0,
            "slug": "",
            "name": ""
          },
          "parent_id": 0,
          "created_at": "",
          "updated_at": ""
        }
      '''
    }
  }
}

