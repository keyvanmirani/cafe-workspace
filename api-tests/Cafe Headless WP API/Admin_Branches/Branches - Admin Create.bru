meta {
  name: Branches - Admin Create
  type: http
  seq: 2
  tags: [
    Admin_Branches
  ]
}

post {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Bruno Branch",
    "slug": "bruno-branch-test",
    "address": "Bruno test address",
    "phone": "02112345678",
    "map_url": "https://maps.google.com",
    "image": "/branch/bruno-test.webp",
    "is_active": 1,
    "sort_order": 10,
    "data": {}
  }
}

