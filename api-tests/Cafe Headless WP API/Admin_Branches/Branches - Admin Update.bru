meta {
  name: Branches - Admin Update
  type: http
  seq: 4
  tags: [
    Admin_Branches
  ]
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/:id
  body: json
  auth: basic
}

params:path {
  id: 1
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Bruno Branch Updated",
    "slug": "bruno-branch-test",
    "address": "Bruno updated address",
    "phone": "02187654321",
    "map_url": "https://maps.google.com",
    "image": "/branch/bruno-test-updated.webp",
    "is_active": 1,
    "sort_order": 20,
    "data": {}
  }
}

