meta {
  name: Branches - Admin Single by ID
  type: http
  seq: 3
  tags: [
    Admin_Branches
  ]
}

get {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/:id
  body: none
  auth: basic
}

params:path {
  id: 1
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/:id
    method: GET
    mode: none
    params:path: {
      id: 1
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

