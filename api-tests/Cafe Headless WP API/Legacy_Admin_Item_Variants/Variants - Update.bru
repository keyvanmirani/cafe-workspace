meta {
  name: Variants - Update
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/items/{{itemId}}/variants/{{variantId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "name": "Updated Variant",
    "description": "updated desc",
    "image": "test-variant",
    "price": "250",
    "is_active": true,
    "sort_order": 5
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
