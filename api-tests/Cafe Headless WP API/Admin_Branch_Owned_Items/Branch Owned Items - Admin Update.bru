meta {
  name: Branch Owned Items - Admin Update
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/wp-json/cafe/v1/admin/branches/{{branchId}}/items/{{itemId}}
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

body:json {
  {
    "category_id": {{categoryId}},
    "name": "Branch Smoke Item Updated",
    "description": "Updated by branch-first smoke validation",
    "image": "",
    "price_raw": "130000",
    "sale_price_raw": null,
    "is_variable": false,
    "is_active": true,
    "sort_order": 21,
    "ingredients": [],
    "data": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
